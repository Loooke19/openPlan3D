+    best = None
+    for room in floor.get("rooms") or []:
+        poly = faces.get(room.get("id"))
+        if poly and _pip(x, y, poly) and (best is None or _area(poly) < best[0]):
+            best = (_area(poly), room)
+    return best[1] if best else None
