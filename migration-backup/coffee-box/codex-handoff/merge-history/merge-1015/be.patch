+def _paint_disk(draw, origin_x, origin_y, cell, x, y, radius_cm):
+    cx = (x - origin_x) / cell
+    cy = (y - origin_y) / cell
+    r = max(1.0, radius_cm / cell)
+    draw.ellipse([cx - r, cy - r, cx + r, cy + r], fill=255)
