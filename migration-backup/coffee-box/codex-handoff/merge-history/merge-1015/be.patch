+        busy=true;
+        try{
+          await onSwitch(item);
+          setOpen(false);
+          await refresh();
+        }catch(error){
+          onStatus(error.message||String(error));
+        }finally{
+          busy=false;
+        }
+      };
+      list.append(button);
+    }
+    syncCurrent();
+  }
+
+  async function refresh(){
+    try{
+      const payload=await api('/api/projects');
+      items=payload.projects||[];
+      renderList();
+    }catch(error){
+      items=[];
+      renderList();
+      onStatus(error.message||String(error));
+    }
+  }
+
+  function beginCreate(){
+    setOpen(true);
+    setCreating(true);
+  }
+
+  trigger.addEventListener('click',async ev=>{
