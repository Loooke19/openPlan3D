+def suggest_restricted_zones(floors: list[dict], links: list[dict] | None = None) -> list[dict]:
+    """Infection-control clusters (ä¸€è„±/äºŒè„±/ç¼“å†²/é‡‡æ ·/ç•™è§‚ â€¦, â‰¥3 rooms within 6 m of each other)
+    become a PROVISIONAL é™åˆ¶é€šè¡ŒåŒº: the cluster bbox padded 1 m, plus stair rooms touching it."""
