+    }catch(error){
+      onStatus(error.message||String(error));
+    }finally{
+      busy=false;
+    }
+  });
+
+  refreshBtn.addEventListener('click',()=>refresh());
+
+  createCancel?.addEventListener('click',()=>setCreating(false));
+
+  createSave?.addEventListener('click',async()=>{
+    const name=(createInput?.value||'').trim();
+    if(!name){
+      onStatus('è¯·å¡«å†™æœºæž„åç§°ã€‚');
+      createInput?.focus();
+      return;
+    }
+    if(busy)return;
+    busy=true;
+    try{
+      const record=await api('/api/projects/empty',{
+        method:'POST',
+        headers:{'Content-Type':'application/json'},
+        body:JSON.stringify({name}),
+      });
+      setCreating(false);
+      await refresh();
+      if(typeof onCreated==='function')await onCreated(record);
+      else await onSwitch(record);
+      onStatus(`å·²åˆ›å»ºæœºæž„ã€Œ${institutionName(record)}ã€ã€‚éœ€è¦æ—¶å†ç‚¹ã€Œå¯¼å…¥å›¾çº¸ã€ä¸Šä¼  PDFã€‚`);
+      setOpen(false);
+    }catch(error){
+      onStatus(error.message||String(error));
+    }finally{
+      busy=false;
+    }
+  });
+
+  createInput?.addEventListener('keydown',ev=>{
+    if(ev.key==='Enter'){
+      ev.preventDefault();
+      createSave?.click();
+    }
+  });
+
+  if(newBtn){
+    newBtn.addEventListener('click',()=>{
+      // Always collect a name in-menu. Do not open the OS file picker here.
+      setCreating(true);
+    });
+  }
+
+  refresh();
+  return {
+    refresh,
+    syncCurrent,
+    setOpen,
+    beginCreate,
+    root,
+  };
+}
