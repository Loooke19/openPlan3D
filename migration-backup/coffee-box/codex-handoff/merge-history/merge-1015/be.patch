+def _stem(text: str) -> tuple[str, str]:
+    """Split a trailing number / bracket note (å†…ç§‘è¯Šå®¤1 â†’ å†…ç§‘è¯Šå®¤ + 1)."""
+    m = _NUM_TAIL.search(text)
+    if m and m.start() >= 2:
+        return text[: m.start()], text[m.start():]
+    return text, ""
