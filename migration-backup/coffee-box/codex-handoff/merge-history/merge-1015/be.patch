+def _strip_label_noise(raw):
+    """Generic OCR clean-up (no per-drawing tables): an area that OCR glued onto the
+    name (ç—…æˆ¿21.994m), stray box/check glyphs (æŠ¤å£«åŠžå…¬å®¤â˜) and a lone Latin letter
+    picked up from a fixture symbol in front of the name (oå«)."""
+    s = re.sub(r"(?:\d+\.\d+\s*(?:mÂ²|m2|ãŽ¡|m)?|\d+\s*(?:mÂ²|m2|ãŽ¡|m))$", "", raw)
+    s = re.sub(r"[^\w\u4e00-\u9fffã€/ï¼ˆï¼‰()]+$", "", s)
+    s = re.sub(r"^[a-z](?=[\u4e00-\u9fff])", "", s)  # lowercase only: keep Bè¶…
+    s = s.replace("(", "ï¼ˆ").replace(")", "ï¼‰")
+    if s.count("ï¼ˆ") > s.count("ï¼‰"):
+        s += "ï¼‰"  # OCR dropped the closing bracket: è¯Šå®¤(ä¸€ â†’ è¯Šå®¤ï¼ˆä¸€ï¼‰
+    s = _split_repeat(s)
+    return s if CJK_RE.search(s) or s.upper() == "PT" else raw
