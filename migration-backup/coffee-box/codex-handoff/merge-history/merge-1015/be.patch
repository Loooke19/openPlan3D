+def _segment_crosses(polyline, x, y):
+    for left, right in zip(polyline, polyline[1:]):
+        span = right["x"] - left["x"]
+        if span == 0 or (left["x"] - x) * (right["x"] - x) > 0:
+            continue
+        crossed = left["y"] + (x - left["x"]) / span * (right["y"] - left["y"])
+        if abs(crossed - y) < 50:
+            return True
+    return False
+
