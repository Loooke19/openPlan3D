+def _is_axis_aligned_rect(pts, tol=CROP_EDGE_TOL):
+    if len(pts) not in (4, 5):
+        return False
+    xs = [p[0] for p in pts]
+    ys = [p[1] for p in pts]
+    x0, x1 = min(xs), max(xs)
+    y0, y1 = min(ys), max(ys)
+    return all(min(abs(p[0] - x0), abs(p[0] - x1)) <= tol for p in pts) and all(
+        min(abs(p[1] - y0), abs(p[1] - y1)) <= tol for p in pts
+    )
