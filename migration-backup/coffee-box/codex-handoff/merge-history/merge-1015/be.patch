+def is_equipment_label(text):
+    """Appliance glyphs on CAD â€” not rooms. Keep å¼€æ°´èŒ¶æ°´é—´ / ç”µè„‘å®¤ / ç©ºè°ƒå¤–æœº."""
+    raw = normalize_ocr_text(text)
+    if not raw:
+        return False
+    # Never demote outdoor AC niches (facility-like equipment rooms on plan).
+    if raw == "ç©ºè°ƒå¤–æœº" or raw.startswith("ç©ºè°ƒå¤–æœº"):
+        return False
+    if raw in EQUIPMENT_DROP:
+        return True
+    if raw == "å¼€æ°´" or raw.startswith("å¼€æ°´å™¨"):
+        return True
+    # Lone å¼€æ°´* without èŒ¶/é—´/å®¤ â†’ equipment callout, not a department.
+    if raw.startswith("å¼€æ°´") and not any(tok in raw for tok in ("èŒ¶", "é—´", "å®¤", "æˆ¿")):
+        return True
+    # Stem match without room/facility suffix (ç”µè„‘ â†’ drop; ç”µè„‘å®¤ â†’ keep).
+    if _EQUIPMENT_STEM_RE.match(raw) and not _ROOM_FACILITY_SUFFIX_RE.search(raw):
+        if "èŒ¶" in raw:  # å¼€æ°´èŒ¶æ°´é—´ already covered; belt-and-suspenders
+            return False
+        return True
