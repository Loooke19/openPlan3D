+
+		/**
+		 * The sample values.
+		 *
+		 * @type {TypedArray}
+		 */
+		this.sampleValues = sampleValues;
+
+		/**
+		 * The value size.
+		 *
+		 * @type {TypedArray}
+		 */
+		this.valueSize = sampleSize;
+
+		/**
+		 * The interpolation settings.
+		 *
+		 * @type {?Object}
