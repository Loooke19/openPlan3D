+def normalize_ocr_text(text):
+    text = unicodedata.normalize("NFKC", str(text or "")).replace(" ", "").strip()
+    text = text.replace("ï½", "m").replace("ãŽ¡", "mÂ²")
+    text = text.strip(" :ï¼šã€‚;ï¼›,ï¼Œã€()*ï¼ˆï¼‰ã€ã€‘[]")
+    # Vision often inserts * / Â· inside CAD-outlined room names.
+    collapsed = text.replace("*", "").replace("Â·", "").replace("â€¢", "")
+    collapsed = collapsed.replace("å„²", "å‚¨")
+    if collapsed in NAME_FIXES:
+        return NAME_FIXES[collapsed]
+    if _STORAGE_NEAR_RE.match(collapsed):
+        return "å‚¨è—"
+    if _AC_NEAR_RE.match(collapsed):
+        return "ç©ºè°ƒå¤–æœº"
+    return NAME_FIXES.get(text, text)
+
