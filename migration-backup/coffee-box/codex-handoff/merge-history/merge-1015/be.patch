+def _expand_repeated_storage_labels(labels):
+    """Split Vision/merge glue like å‚¨è—å‚¨è— â†’ N separate å‚¨è— along the bbox."""
+    expanded = []
+    for label in labels:
+        text = label.get("text") or ""
+        if re.fullmatch(r"(?:å‚¨è—){2,}", text):
+            count = len(text) // 2
+            x0 = float(label.get("x0", label["x"] - 8))
+            x1 = float(label.get("x1", label["x"] + 8))
+            span = max(x1 - x0, 12.0 * count)
+            step = span / count
+            for index in range(count):
+                lx0 = x0 + index * step
+                lx1 = lx0 + step
+                expanded.append({
+                    **label,
+                    "text": "å‚¨è—",
+                    "x": (lx0 + lx1) / 2,
+                    "x0": lx0,
+                    "x1": lx1,
+                })
+            continue
+        expanded.append(label)
+    return expanded
+
