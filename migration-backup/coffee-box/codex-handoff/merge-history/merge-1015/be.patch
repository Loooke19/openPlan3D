+_HIDDEN_POIS: list = []  # last build's unsearchable OCR labels (acceptance report)
+_NOT_PLACES = {"æŸœå­", "è´§æž¶", "å™¨æ¢°æŸœ", "è¡£æŸœ", "å‚¨ç‰©æŸœ", "éž‹æŸœ", "ä¸Šç©º", "å¤©äº•", "åŽŸåœ°é¢"}
+_EXTRA_PLACE_WORDS = ("å¼€æ°´ç‚‰", "å¼€æ°´å™¨", "é¥®æ°´æœº", "è‡ªåŠ©æœº", "å¯¼åŒ»å°", "å¯¼è¯Šå°", "æœåŠ¡å°", "å’¨è¯¢å°", "æŒ‚å·", "æ”¶è´¹", "å–è¯",
+                      "æ€¥è¯Š", "é—¨è¯Š", "è¯æˆ¿", "æŠ¤å£«ç«™", "åˆ†è¯Š")
