+"""Inspect uploaded PDFs without executing embedded JavaScript or launching files."""
+from pypdf import PdfReader
+from pypdf.errors import PdfReadError
+
+
+class PdfRejected(ValueError):
+    def __init__(self, message, status_code=400):
+        super().__init__(message)
+        self.status_code = status_code
+
+
+def inspect_pdf(path, max_pages):
+    header = path.read_bytes()[:8]
+    if not header.startswith(b"%PDF"):
+        raise PdfRejected("ä¸æ˜¯æœ‰æ•ˆçš„ PDF æ–‡ä»¶ã€‚")
+    try:
+        reader = PdfReader(str(path), strict=False)
+    except PdfReadError as error:
+        raise PdfRejected("æ— æ³•è¯»å–è¿™ä»½ PDFï¼Œæ–‡ä»¶å¯èƒ½å·²æŸåã€‚") from error
+    except Exception as error:
+        raise PdfRejected("æ— æ³•è¯»å–è¿™ä»½ PDFã€‚") from error
+    if getattr(reader, "is_encrypted", False):
+        raise PdfRejected("æ— æ³•è¯»å–åŠ å¯† PDFã€‚è¯·å…ˆåœ¨æœ¬åœ°è§£é™¤åŠ å¯†åŽå†ä¸Šä¼ ã€‚")
+    count = len(reader.pages)
+    if count < 1:
+        raise PdfRejected("è¿™ä»½ PDF æ²¡æœ‰å¯æ˜¾ç¤ºçš„é¡µé¢ã€‚")
+    if count > max_pages:
+        raise PdfRejected(f"é¡µæ•°è¶…è¿‡é™åˆ¶ï¼ˆæœ€å¤š {max_pages} é¡µï¼‰ã€‚")
+    pages = []
+    for index, page in enumerate(reader.pages, start=1):
+        box = page.mediabox
+        width = float(box.width)
+        height = float(box.height)
+        if not (width > 0 and height > 0):
+            raise PdfRejected(f"ç¬¬ {index} é¡µå°ºå¯¸æ— æ•ˆã€‚")
+        pages.append({"index": index, "originalSize": [width, height]})
+    return pages
