+
+export function facilityChipBox(x, y, unit, name, showText) {
+  const r = FACILITY_BADGE_RADIUS * unit;
+  const halfH = Math.max(r, FACILITY_LABEL_HEIGHT * unit / 2);
+  if (!showText) return { left: x - r, right: x + r, top: y - r, bottom: y + r };
