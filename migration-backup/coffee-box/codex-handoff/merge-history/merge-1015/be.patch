+        "floors": floors,
+        "source": {
+            "sourceKind": "openplan",
+            "pdfSize": pdf_size,
+            "imageSize": pdf_size,
+        },
+        "calibration": {
+            "metersPerMapUnit": MAP_UNIT_CM / 100.0,
+            "source": "openplan-cm",
+        },
+        "geometry": {
+            "buildingBoundary": boundary,
+            "obstacles": obstacles,
