+def _restore_womens_toilets(labels):
+    """CAD single-stroke ã€Œå¥³ã€ is often dropped by OCR, leaving a lone ã€Œå«ã€ beside ã€Œç”·å«ã€.
+
+    For each ç”·å« on the sheet without a å¥³å«, the nearest lone å« within ~40 pt (a few metres)
+    becomes å¥³å«. Lone å« elsewhere (ward en-suites) are left alone.
+    """
+    if any(l["text"] == "å¥³å«" for l in labels):
+        return
+    lone = [l for l in labels if l["text"] == "å«"]
+    for man in [l for l in labels if l["text"] == "ç”·å«"]:
+        near = sorted(lone, key=lambda l: math.hypot(l["x"] - man["x"], l["y"] - man["y"]))
+        if near and math.hypot(near[0]["x"] - man["x"], near[0]["y"] - man["y"]) <= 160:
+            near[0]["raw"] = near[0].get("raw") or "å«"
+            near[0]["text"] = "å¥³å«"
+            lone.remove(near[0])
+
+
+def _restore_womens_toilet_rooms(rooms):
+    """Same å¥³å« rule on named rooms (crop OCR also reads only ã€Œå«ã€)."""
+    if any(r.get("name") == "å¥³å«" for r in rooms):
+        return
+    def centre(r):
+        pts = r["polygon"]
+        return sum(p["x"] for p in pts) / len(pts), sum(p["y"] for p in pts) / len(pts)
+    lone = [r for r in rooms if r.get("name") == "å«"]
+    for man in [r for r in rooms if r.get("name") == "ç”·å«"]:
+        mx, my = centre(man)
+        near = sorted(lone, key=lambda r: math.hypot(centre(r)[0] - mx, centre(r)[1] - my))
+        if near and math.hypot(centre(near[0])[0] - mx, centre(near[0])[1] - my) <= 1200:
+            near[0]["name"] = "å¥³å«"
+            lone.remove(near[0])
+
