+def _matches_rect(pts, x, y, width, height, tol=CROP_EDGE_TOL):
+    if not pts or not _is_axis_aligned_rect(pts, tol):
+        return False
+    x0, y0, x1, y1 = _bbox(pts)
+    return (
+        abs(x0 - x) <= tol
+        and abs(y0 - y) <= tol
+        and abs(x1 - (x + width)) <= tol
+        and abs(y1 - (y + height)) <= tol
+    )
