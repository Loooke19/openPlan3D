+OCR_TILE_PX = int(os.environ.get("CAD_OCR_TILE_PX", "1400"))
+OCR_TILE_DPI = int(os.environ.get("CAD_OCR_TILE_DPI", "300"))
+OCR_TRUST_CONF = float(os.environ.get("CAD_OCR_TRUST_CONF", "0.97"))
