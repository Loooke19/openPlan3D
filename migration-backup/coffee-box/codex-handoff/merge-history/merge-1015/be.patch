+        if len(lines) >= 12 and structure and len(structure.get("rooms") or []) >= 10:
+            break
+    lines = chosen["lines"] if chosen else []
+    crop = chosen["crop"] if chosen else crops[0]
+    doors_in = []
+    rooms_in = []
+    stairs_in = []
