+def _face_bounds(face: dict):
+    polygon = face.get("polygon") or []
+    if len(polygon) < 3:
+        return 0.0, 0.0, 0.0
+    xs = [float(point["x"]) for point in polygon]
+    ys = [float(point["y"]) for point in polygon]
+    width = max(xs) - min(xs)
