+.list-heading,.poi-list-item{border-color:#e2e8e8}.poi-list-item:hover{background:#f2f6f4}.poi-list-item.is-selected{background:#e4efea}
+.map-area{border-color:#dce3e7;box-shadow:inset 0 1px 0 #fff}
+.route-fields select,.journey-summary,.zoom-controls button+button{border-color:#dce4e1}
