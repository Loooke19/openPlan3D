+      const c = median(run.map(cross));
+      const byA = new Map<number, LightSpot>();
+      for (const s of run) { const k = Math.round(along(s)); if (!byA.has(k)) byA.set(k, s); }
+      for (const [k] of byA) out.push(long ? { x: k, z: c, long } : { x: c, z: k, long });
+    }
+  }
+  return out;
+}
