+    if (Math.abs(dp) < 1e-9) return p0 >= min && p0 <= max;
+    let a = (min - p0) / dp, b = (max - p0) / dp; if (a > b) [a, b] = [b, a];
+    lo = Math.max(lo, a); hi = Math.min(hi, b); return lo < hi;
