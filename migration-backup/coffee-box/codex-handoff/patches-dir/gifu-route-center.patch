+def _seg_axis(p, q):
+    dx, dy = abs(q[0] - p[0]), abs(q[1] - p[1])
+    ang = math.degrees(math.atan2(dy, dx))
+    if ang <= _RUN_MAX_ANGLE:
+        return 1
+    if ang >= 90 - _RUN_MAX_ANGLE:
+        return 0
+    return -1
+
