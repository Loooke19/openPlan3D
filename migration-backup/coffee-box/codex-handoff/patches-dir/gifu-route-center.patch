+_CENTER_MIN_SEG_CM = 150.0
+_CENTER_MAX_SHIFT_CM = 150.0
+_CENTER_LEAD_CM = 120.0
+
+
+_SNAP_STEP_CM = 40.0
+_SNAP_MAX_WIDTH_CM = 450.0
+
