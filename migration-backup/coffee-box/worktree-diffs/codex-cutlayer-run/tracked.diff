+function placeProps(walls: KitWall[], wallBoxes: KitBox[], doors: KitDoor[], rooms: KitRoom[], trims: KitBox[], allow: (r: KitRoom) => boolean, inRoom: (p: P, r: KitRoom) => boolean, corridor: KitRoom, keep: P[], signs: KitBox[]): KitBox[] {
