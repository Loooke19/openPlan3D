+
+  it('stops at the approach endpoints when progress is outside the animation interval', () => {
+    const from = { x: -1312.3, y: 144.8 };
+    expect(transferStepPose(from, 0, -0.5, 'up', true)).toEqual({ ...from, rise: 0 });
