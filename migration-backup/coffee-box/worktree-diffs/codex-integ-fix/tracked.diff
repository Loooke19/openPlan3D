+            self.assertEqual(written, source.replace('[]\n}', json.dumps(floors[0]["stairs"], indent=1) + '\n}'))
+            overrides.write_stair_overrides(floors, "test")
+            self.assertEqual(path.read_text(encoding="utf-8"), written)
+
