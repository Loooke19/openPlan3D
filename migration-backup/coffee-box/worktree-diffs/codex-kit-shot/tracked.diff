+      let lo = Infinity, hi = -Infinity;
+      for (let i = 0; i < pos.count; i++) { const q = pos.getX(i) * v.x + pos.getZ(i) * v.z; lo = Math.min(lo, q); hi = Math.max(hi, q); }
