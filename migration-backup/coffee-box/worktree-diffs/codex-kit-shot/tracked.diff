+  return out;
+}
+
+/** Holes overlapping an earlier hole on the same line (duplicate door records) → index of the keeper. */
+export function holeKeeper(holes: Hole[], i: number): number {
+  const h = holes[i];
+  for (let j = 0; j < i; j++) {
+    const k = holes[j];
+    if (Math.abs(h.u.x * k.u.y - h.u.y * k.u.x) > 0.02) continue;
