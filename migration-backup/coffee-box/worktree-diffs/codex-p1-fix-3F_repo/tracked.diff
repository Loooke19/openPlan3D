+            floor["walls"] = walls = [w for w in walls if w["id"] not in drop]
+            floor["doors"] = [d for d in floor.get("doors") or [] if d.get("wallId") not in drop]
+            stats["walls_remove"] = stats.get("walls_remove", 0) + len(drop)
