+export function alignRuns(spots: LightSpot[], step = 300): LightSpot[] {
+  const out: LightSpot[] = [];
+  for (const long of [true, false]) {
+    const along = (s: LightSpot) => long ? s.x : s.z, cross = (s: LightSpot) => long ? s.z : s.x;
