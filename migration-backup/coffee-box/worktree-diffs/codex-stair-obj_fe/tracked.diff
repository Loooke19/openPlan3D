+      for (let grew = true; grew;) {
+        grew = false;
+        const mid = median(run.map(cross));
+        for (const s of pool) if (!used.has(s) && Math.abs(cross(s) - mid) <= 45 && run.some(r => Math.abs(along(r) - along(s)) <= step * 1.5)) { run.push(s); used.add(s); grew = true; }
