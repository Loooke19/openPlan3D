@@ -4,10 +4,24 @@ import { addFloor, createDefaultFloor, currentProject, loadProject, removeFloor,
 import { roomProject } from './fixtures/project';
 import { updateFloorElevation, updateFloorSlabThickness } from '$lib/stores/project';
